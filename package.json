{
  "name": "dungeon-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:local && vite build && wrangler dev",
    "dev:ui": "vite",
    "build": "vite build",
    "deploy": "vite build && wrangler d1 migrations apply dungeon-manager --remote && wrangler deploy",
    "test": "vite build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply dungeon-manager --local",
    "db:migration": "wrangler d1 migrations create dungeon-manager"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@xyflow/react": "^12.11.6",
    "d3-force": "^3.0.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.9",
    "@types/d3-force": "^3.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.131.2"
  }
}
